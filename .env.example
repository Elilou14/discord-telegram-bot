# Copy this file to .env and fill in real values. Never commit .env.
# See the README for how to obtain each token.

# --- Discord bot (node/) ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register slash commands to one guild instantly instead of
# waiting up to an hour for the global command cache to refresh.
DISCORD_GUILD_ID=

# --- Telegram bot (python/) ---
TELEGRAM_BOT_TOKEN=

# --- Moderation (shared, read by both bots) ---
# Comma-separated, matched whole-word and case-insensitively.
BANNED_WORDS=
# How many messages within the window count as flooding.
FLOOD_MAX_MESSAGES=5
FLOOD_WINDOW_MS=10000
# Warning counts at which a mute/kick is recommended.
WARN_MUTE_THRESHOLD=3
WARN_KICK_THRESHOLD=5
